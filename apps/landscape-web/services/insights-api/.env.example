NODE_ENV=development
HOST=127.0.0.1
PORT=8080

# Generate with: openssl rand -base64 48
INSIGHTS_API_TOKEN=replace-with-at-least-32-random-characters

CLICKHOUSE_HOST=clickhouse.internal.example
CLICKHOUSE_USER=landscape_readonly
CLICKHOUSE_PASSWORD=replace-me

# Preferred for any connection that crosses a network boundary.
CLICKHOUSE_URL=https://clickhouse.internal.example:8443

# Only use this when the service and ClickHouse communicate exclusively over
# a trusted private network. The hostname must resolve to private addresses.
# CLICKHOUSE_ALLOW_PRIVATE_HTTP=true

# Optional GitHub API token for higher rate limits.
# GITHUB_TOKEN=

CACHE_TTL_SECONDS=86400
CACHE_MAX_ENTRIES=300
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# Set only when the ingress/reverse proxy is controlled by you.
INSIGHTS_TRUST_PROXY=false
